{
    "name": "particle-academy/laravel-courses",
    "description": "Laravel package for selling and serving educational curriculums, courses, tests, and certificates.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "particle-academy/fine-print": ">=0.3.0 <2.0",
        "particle-academy/fancy-template": ">=0.3.0 <2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "ParticleAcademy\\LaravelCourses\\": "src/",
            "ParticleAcademy\\LaravelCourses\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ParticleAcademy\\LaravelCourses\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ParticleAcademy\\LaravelCourses\\CoursesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
